# Bubblewrap CLI install (this folder is intentionally outside the pnpm
# workspace so it doesn't get swept into the root lockfile).
node_modules/
package-lock.json

# Downloaded JDK 17 + Android SDK command-line tools (~1GB+, machine-specific).
tools/

# The app signing key. Losing this is fine (it's backed up elsewhere) —
# committing it is not: anyone with the file + password could sign updates
# to the published app. Never commit this.
android.keystore
signing-key-credentials.DO-NOT-COMMIT.json

# Gradle build output.
app/build/
build/
.gradle/
local.properties

# Build artifacts — regenerated by build-project.js, not source. Upload the
# .aab to Play Console directly rather than committing it.
*.aab
*.apk
