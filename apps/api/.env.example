# Postgres connection string used by Prisma and the Nest app.
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/online_tutor?schema=public"

PORT=3001

# Origin of the Next.js web app, for CORS.
WEB_ORIGIN="http://localhost:3000"

# JWT signing secret for auth cookies. Must match apps/web's AUTH_JWT_SECRET
# (generate a real random value per environment, e.g. `openssl rand -base64 32`).
JWT_SECRET="change-me"

# Used by `prisma db seed` to provision the first admin account (admins can't self-register).
ADMIN_EMAIL="admin@online-tutor.local"
ADMIN_PASSWORD="change-me-admin"
ADMIN_NAME="Platform Admin"

# PayFast (sandbox values for local dev).
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""

# S3-compatible file storage.
S3_BUCKET=""
S3_REGION="af-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
