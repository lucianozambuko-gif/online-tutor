# Postgres connection string the running app uses (PrismaService, prisma/seed.ts).
# On Neon (or any pooled provider) this should be the POOLED connection string.
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/online_tutor?schema=public"

# Connection string the Prisma CLI uses for migrations (see prisma7.config.ts).
# On Neon this should be the DIRECT (non-pooled) connection string — migrations
# do DDL/locking that isn't reliable through a transaction-mode pooler. For a
# plain local Postgres (no pooler involved) this can just equal DATABASE_URL.
DIRECT_URL="postgresql://johndoe:randompassword@localhost:5432/online_tutor?schema=public"

PORT=3001

# Origin of the Next.js web app, for CORS.
WEB_ORIGIN="http://localhost:3000"

# JWT signing secret for auth cookies. Must match apps/web's AUTH_JWT_SECRET
# (generate a real random value per environment, e.g. `openssl rand -base64 32`).
JWT_SECRET="change-me"

# Used by `prisma db seed` to provision the first admin account (admins can't self-register).
ADMIN_EMAIL="admin@online-tutor.local"
ADMIN_PASSWORD="change-me-admin"
ADMIN_NAME="Platform Admin"

# PayFast (sandbox values for local dev). Get sandbox credentials at
# https://developers.payfast.co.za/ — until then, payment initiation still
# generates correctly-shaped/signed fields, they just won't authenticate.
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX="true"

# Publicly reachable base URL for this API, used as PayFast's ITN notify_url.
# localhost won't actually be reachable by PayFast — use a tunnel (e.g. ngrok)
# to test real webhook delivery locally.
API_PUBLIC_URL="http://localhost:3001"

# Platform's cut of each booking's payment, taken from the tutor's payout.
PLATFORM_COMMISSION_PERCENT="15"

# S3-compatible file storage.
S3_BUCKET=""
S3_REGION="af-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
