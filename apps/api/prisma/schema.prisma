// Prisma schema for the online-tutor platform.
// See ARCHITECTURE.md for the data model this is derived from.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum UserStatus {
  PENDING_GUARDIAN_CONSENT
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BackgroundCheckStatus {
  NOT_REQUIRED
  PENDING
  CLEARED
  FLAGGED
}

enum BookingMode {
  ONLINE
  IN_PERSON
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  PAYFAST
  EFT
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum PolicyType {
  TOS
  PRIVACY
  SAFEGUARDING
  REFUND
  TUTOR_CODE_OF_CONDUCT
  GUARDIAN_CONSENT
}

enum GuardianConsentStatus {
  PENDING
  CONSENTED
  EXPIRED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  phone           String?
  passwordHash    String
  role            Role
  status          UserStatus @default(ACTIVE)
  name            String
  avatarUrl       String?
  dateOfBirth     DateTime?
  guardianContact String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  studentProfile StudentProfile?
  tutorProfile   TutorProfile?
  studentsAsGuardian StudentProfile[] @relation("Guardian")

  bookingsAsStudent Booking[] @relation("StudentBookings")
  bookingsAsTutor   Booking[] @relation("TutorBookings")

  paymentsMade Payment[]
  payouts      Payout[]

  sentMessages              Message[]
  conversationParticipants  ConversationParticipant[]

  resources Resource[]

  reviewsGiven    Review[] @relation("ReviewByStudent")
  reviewsReceived Review[] @relation("ReviewOfTutor")

  policyAcceptances PolicyAcceptance[]

  disputesRaised  Dispute[] @relation("DisputeRaisedBy")
  disputesAgainst Dispute[] @relation("DisputeAgainst")

  auditLogs       AuditLog[]
  offlineSyncLogs OfflineSyncLog[]

  guardianConsentRequest GuardianConsentRequest?

  aiConversation AiConversation?

  notes         Note[]
  flashcardSets FlashcardSet[]
  quizzes       Quiz[]
}

// One persistent AI-helper thread per student (not per booking) — kept
// simple as a single ongoing conversation rather than a conversation list.
// Persisted, not just proxied, so it fits the same "logged, reviewable"
// posture as the rest of this platform's messaging (this involves minors).
model AiConversation {
  id        String      @id @default(cuid())
  studentId String      @unique
  student   User        @relation(fields: [studentId], references: [id])
  createdAt DateTime    @default(now())
  messages  AiMessage[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id])
  role           AiMessageRole
  content        String
  createdAt      DateTime       @default(now())
}

enum AiMessageRole {
  USER
  ASSISTANT
}

// AI-generated study notes a student asked for — optionally grounded in
// source text they pasted in (lecture notes, a textbook excerpt, etc.).
model Note {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  topic      String
  subject    String?
  content    String
  sourceType String?
  createdAt  DateTime @default(now())

  flashcardSets FlashcardSet[]
  quizzes       Quiz[]
}

model FlashcardSet {
  id        String      @id @default(cuid())
  studentId String
  student   User        @relation(fields: [studentId], references: [id])
  noteId    String?
  note      Note?       @relation(fields: [noteId], references: [id])
  topic     String
  createdAt DateTime    @default(now())
  cards     Flashcard[]
}

model Flashcard {
  id    String       @id @default(cuid())
  setId String
  set   FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  front String
  back  String
}

model Quiz {
  id             String         @id @default(cuid())
  studentId      String
  student        User           @relation(fields: [studentId], references: [id])
  topic          String
  difficulty     String?
  noteId         String?
  note           Note?          @relation(fields: [noteId], references: [id])
  createdAt      DateTime       @default(now())
  attempted      Boolean        @default(false)
  score          Int?
  totalQuestions Int?
  completedAt    DateTime?
  questions      QuizQuestion[]
}

model QuizQuestion {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question    String
  options     String[]
  answerIndex Int
  explanation String
}

model StudentProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  gradeLevel         String?
  subjectsOfInterest String[]
  guardianId         String?
  guardian           User?    @relation("Guardian", fields: [guardianId], references: [id])
}

// Created at signup for a student who is under 18. Holds the single-use token
// a guardian uses to review and accept the guardian-consent policy on the
// student's behalf; the student's account stays PENDING_GUARDIAN_CONSENT
// until this is CONSENTED.
model GuardianConsentRequest {
  id            String                @id @default(cuid())
  studentId     String                @unique
  student       User                  @relation(fields: [studentId], references: [id])
  guardianName  String
  guardianEmail String
  token         String                @unique
  status        GuardianConsentStatus @default(PENDING)
  createdAt     DateTime              @default(now())
  expiresAt     DateTime
  consentedAt   DateTime?
}

model TutorProfile {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  user                   User                   @relation(fields: [userId], references: [id])
  subjects               String[]
  qualifications         String[]
  verificationStatus     VerificationStatus     @default(PENDING)
  idDocumentRef          String?
  backgroundCheckStatus  BackgroundCheckStatus  @default(NOT_REQUIRED)
  hourlyRate             Decimal                @db.Decimal(10, 2)
  bio                    String?
  avgRating              Decimal?               @db.Decimal(3, 2)
}

model Booking {
  id              String        @id @default(cuid())
  studentId       String
  student         User          @relation("StudentBookings", fields: [studentId], references: [id])
  tutorId         String
  tutor           User          @relation("TutorBookings", fields: [tutorId], references: [id])
  subject         String
  scheduledAt     DateTime
  durationMinutes Int
  mode            BookingMode
  status          BookingStatus @default(PENDING)
  sessionNotesUrl String?
  recordingUrl    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment      Payment?
  conversation Conversation?
  review       Review?
  disputes     Dispute[]
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id])
  payerId           String
  payer             User          @relation(fields: [payerId], references: [id])
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("ZAR")
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  platformFee       Decimal       @db.Decimal(10, 2)
  tutorPayoutAmount Decimal       @db.Decimal(10, 2)
  payfastRef        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Payout {
  id           String       @id @default(cuid())
  tutorId      String
  tutor        User         @relation(fields: [tutorId], references: [id])
  periodStart  DateTime
  periodEnd    DateTime
  totalAmount  Decimal      @db.Decimal(10, 2)
  status       PayoutStatus @default(PENDING)
  payoutMethod String       @default("EFT")
  reference    String?
  paidAt       DateTime?
  createdAt    DateTime     @default(now())
}

model Conversation {
  id        String   @id @default(cuid())
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  sentAt         DateTime     @default(now())
  flagged        Boolean      @default(false)
}

model Resource {
  id                  String   @id @default(cuid())
  ownerId             String
  owner               User     @relation(fields: [ownerId], references: [id])
  subject             String
  title               String
  fileUrl             String
  downloadableOffline Boolean  @default(false)
  version             Int      @default(1)
  createdAt           DateTime @default(now())
}

model OfflineSyncLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  deviceId       String
  lastSyncedAt   DateTime
  pendingActions Json?
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  studentId String
  student   User     @relation("ReviewByStudent", fields: [studentId], references: [id])
  tutorId   String
  tutor     User     @relation("ReviewOfTutor", fields: [tutorId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model PolicyAcceptance {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  policyType PolicyType
  version    String
  acceptedAt DateTime   @default(now())

  @@unique([userId, policyType, version])
}

model Dispute {
  id              String        @id @default(cuid())
  raisedById      String
  raisedBy        User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  againstId       String
  against         User          @relation("DisputeAgainst", fields: [againstId], references: [id])
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id])
  reason          String
  status          DisputeStatus @default(OPEN)
  resolutionNotes String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  timestamp  DateTime @default(now())
}
