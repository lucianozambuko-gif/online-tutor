// Prisma schema for the online-tutor platform.
// See ARCHITECTURE.md for the data model this is derived from.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum SubscriptionPlan {
  FREE
  PLUS
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum UserStatus {
  PENDING_GUARDIAN_CONSENT
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BackgroundCheckStatus {
  NOT_REQUIRED
  PENDING
  CLEARED
  FLAGGED
}

enum BookingMode {
  ONLINE
  IN_PERSON
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  PAYFAST
  EFT
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum PolicyType {
  TOS
  PRIVACY
  SAFEGUARDING
  REFUND
  TUTOR_CODE_OF_CONDUCT
  GUARDIAN_CONSENT
}

enum GuardianConsentStatus {
  PENDING
  CONSENTED
  EXPIRED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum IssueCategory {
  BOOKING
  PAYMENT
  TECHNICAL
  ACCOUNT
  OTHER
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  phone           String?
  passwordHash    String
  role            Role
  status          UserStatus @default(ACTIVE)
  name            String
  avatarUrl       String?
  dateOfBirth     DateTime?
  guardianContact String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  studentProfile StudentProfile?
  tutorProfile   TutorProfile?
  studentsAsGuardian StudentProfile[] @relation("Guardian")

  bookingsAsStudent Booking[] @relation("StudentBookings")
  bookingsAsTutor   Booking[] @relation("TutorBookings")

  paymentsMade Payment[]
  payouts      Payout[]

  subscription Subscription?

  sentMessages              Message[]
  conversationParticipants  ConversationParticipant[]

  resources Resource[]

  reviewsGiven    Review[] @relation("ReviewByStudent")
  reviewsReceived Review[] @relation("ReviewOfTutor")

  policyAcceptances PolicyAcceptance[]

  disputesRaised  Dispute[] @relation("DisputeRaisedBy")
  disputesAgainst Dispute[] @relation("DisputeAgainst")

  issueReports IssueReport[]

  auditLogs       AuditLog[]
  offlineSyncLogs OfflineSyncLog[]

  guardianConsentRequest GuardianConsentRequest?

  aiConversation AiConversation?

  notes         Note[]
  flashcardSets FlashcardSet[]
  quizzes       Quiz[]

  tutorNotesWritten TutorNote[] @relation("TutorNotesByTutor")
  tutorNotesAboutMe TutorNote[] @relation("TutorNotesAboutStudent")
}

// One persistent AI-helper thread per student (not per booking) — kept
// simple as a single ongoing conversation rather than a conversation list.
// Persisted, not just proxied, so it fits the same "logged, reviewable"
// posture as the rest of this platform's messaging (this involves minors).
model AiConversation {
  id        String      @id @default(cuid())
  studentId String      @unique
  student   User        @relation(fields: [studentId], references: [id])
  createdAt DateTime    @default(now())
  messages  AiMessage[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id])
  role           AiMessageRole
  content        String
  // Files the student attached (images and/or PDF/Word documents) — a JSON
  // array since a message can carry more than one, capped per plan (see
  // PLAN_LIMITS.maxFilesPerMessage). Images keep their base64 for display
  // (no object storage set up); documents keep only their extracted text.
  // Shape: { kind: "IMAGE"; name; mimeType; data } | { kind: "DOCUMENT"; name; mimeType; text }
  attachments    Json?
  createdAt      DateTime       @default(now())
}

enum AiMessageRole {
  USER
  ASSISTANT
}

// AI-generated study notes a student asked for — optionally grounded in
// source text they pasted in (lecture notes, a textbook excerpt, etc.).
model Note {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  topic      String
  subject    String?
  content    String
  sourceType String?
  createdAt  DateTime @default(now())

  flashcardSets FlashcardSet[]
  quizzes       Quiz[]
}

model FlashcardSet {
  id        String      @id @default(cuid())
  studentId String
  student   User        @relation(fields: [studentId], references: [id])
  noteId    String?
  note      Note?       @relation(fields: [noteId], references: [id])
  topic     String
  createdAt DateTime    @default(now())
  cards     Flashcard[]
}

model Flashcard {
  id    String       @id @default(cuid())
  setId String
  set   FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  front String
  back  String
}

model Quiz {
  id             String         @id @default(cuid())
  studentId      String
  student        User           @relation(fields: [studentId], references: [id])
  topic          String
  difficulty     String?
  noteId         String?
  note           Note?          @relation(fields: [noteId], references: [id])
  createdAt      DateTime       @default(now())
  attempted      Boolean        @default(false)
  score          Int?
  totalQuestions Int?
  completedAt    DateTime?
  questions      QuizQuestion[]
}

model QuizQuestion {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question    String
  options     String[]
  answerIndex Int
  explanation String
}

model StudentProfile {
  id                 String           @id @default(cuid())
  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id])
  gradeLevel         String?
  institutionType    InstitutionType?
  subjectsOfInterest String[]
  guardianId         String?
  guardian           User?            @relation("Guardian", fields: [guardianId], references: [id])
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  VARSITY
  ONLINE_INSTITUTE
}

// Created at signup for a student who is under 18. Holds the single-use token
// a guardian uses to review and accept the guardian-consent policy on the
// student's behalf; the student's account stays PENDING_GUARDIAN_CONSENT
// until this is CONSENTED.
model GuardianConsentRequest {
  id            String                @id @default(cuid())
  studentId     String                @unique
  student       User                  @relation(fields: [studentId], references: [id])
  guardianName  String
  guardianEmail String
  token         String                @unique
  status        GuardianConsentStatus @default(PENDING)
  createdAt     DateTime              @default(now())
  expiresAt     DateTime
  consentedAt   DateTime?
}

model TutorProfile {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  user                   User                   @relation(fields: [userId], references: [id])
  subjects               String[]
  // Which school phases this tutor covers — a South African tutor commonly
  // spans more than one (e.g. High School and Varsity), so it's a set.
  gradeLevels            GradeLevel[]           @default([])
  qualifications         String[]
  verificationStatus     VerificationStatus     @default(PENDING)
  idDocumentRef          String?
  backgroundCheckStatus  BackgroundCheckStatus  @default(NOT_REQUIRED)
  hourlyRate             Decimal                @db.Decimal(10, 2)
  bio                    String?
  avgRating              Decimal?               @db.Decimal(3, 2)
  // Optional proof of marks/qualifications for the subjects offered — an
  // admin reviews it and flips transcriptVerified, which becomes a public
  // trust signal on the tutor's listing. Not required to be bookable.
  transcriptData         String?
  transcriptMimeType     String?
  transcriptName         String?
  transcriptVerified     Boolean                @default(false)
}

enum GradeLevel {
  PRIMARY
  HIGH_SCHOOL
  VARSITY
}

model Booking {
  id              String        @id @default(cuid())
  studentId       String
  student         User          @relation("StudentBookings", fields: [studentId], references: [id])
  tutorId         String
  tutor           User          @relation("TutorBookings", fields: [tutorId], references: [id])
  subject         String
  scheduledAt     DateTime
  durationMinutes Int
  mode            BookingMode
  status          BookingStatus @default(PENDING)
  sessionNotesUrl String?
  recordingUrl    String?
  // Auto-generated Jitsi Meet room for ONLINE bookings, set at creation time.
  meetingUrl      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment      Payment?
  conversation Conversation?
  review       Review?
  disputes     Dispute[]
  issueReports IssueReport[]
  tutorNotes   TutorNote[]
}

// A tutor's own notes on a student's progress — separate from the student's
// AI-generated study Notes model. Optionally tied to a student (studentId)
// and/or a specific session (bookingId), or fully general (both null) for a
// tutor's own prep/reminders that don't require any existing booking.
// Optionally AI-polished from a tutor's rough bullet points via the same
// GroqService as the student-side features.
model TutorNote {
  id        String   @id @default(cuid())
  tutorId   String
  tutor     User     @relation("TutorNotesByTutor", fields: [tutorId], references: [id])
  studentId String?
  student   User?    @relation("TutorNotesAboutStudent", fields: [studentId], references: [id])
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])
  topic     String
  content   String
  // An optional file/photo the tutor attaches alongside the note (e.g. a
  // worksheet scan) — reference material only, not read by the AI.
  attachmentData     String?
  attachmentMimeType String?
  attachmentName     String?
  createdAt DateTime @default(now())
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id])
  payerId           String
  payer             User          @relation(fields: [payerId], references: [id])
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("ZAR")
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  platformFee       Decimal       @db.Decimal(10, 2)
  tutorPayoutAmount Decimal       @db.Decimal(10, 2)
  payfastRef        String?
  payoutId          String?
  payout            Payout?       @relation(fields: [payoutId], references: [id])
  // Set once a refund (full or partial) has actually gone through via
  // PayFast's refund API — refundedAmount is the cumulative total refunded
  // so far, in rand, not just the most recent refund.
  refundedAmount    Decimal?      @db.Decimal(10, 2)
  refundReason      String?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Payout {
  id           String       @id @default(cuid())
  tutorId      String
  tutor        User         @relation(fields: [tutorId], references: [id])
  periodStart  DateTime
  periodEnd    DateTime
  totalAmount  Decimal      @db.Decimal(10, 2)
  status       PayoutStatus @default(PENDING)
  payoutMethod String       @default("EFT")
  reference    String?
  paidAt       DateTime?
  createdAt    DateTime     @default(now())

  payments Payment[]
}

// One row per student, lazily created as FREE on first use. periodStart/
// periodEnd bound the current usage window — for FREE this is just a rolling
// 30 days from periodStart (reset lazily whenever it's checked); for a paid
// plan it's the current PayFast billing cycle, extended by the ITN handler on
// each successful renewal charge.
model Subscription {
  id             String             @id @default(cuid())
  studentId      String             @unique
  student        User               @relation(fields: [studentId], references: [id])
  plan           SubscriptionPlan   @default(FREE)
  status         SubscriptionStatus @default(ACTIVE)
  payfastToken   String?
  periodStart    DateTime           @default(now())
  periodEnd      DateTime?
  aiMessagesUsed Int                @default(0)
  generationsUsed Int               @default(0)
  // Free plan's AI Helper limit is a short rolling window (see
  // FREE_AI_MESSAGE_WINDOW_HOURS) rather than the monthly period above, so it
  // needs its own start marker — null until the student's first AI message.
  aiMessageWindowStart DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Conversation {
  id        String   @id @default(cuid())
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  sentAt         DateTime     @default(now())
  flagged        Boolean      @default(false)
}

model Resource {
  id                  String   @id @default(cuid())
  ownerId             String
  owner               User     @relation(fields: [ownerId], references: [id])
  subject             String
  title               String
  fileUrl             String
  downloadableOffline Boolean  @default(false)
  version             Int      @default(1)
  createdAt           DateTime @default(now())
}

model OfflineSyncLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  deviceId       String
  lastSyncedAt   DateTime
  pendingActions Json?
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  studentId String
  student   User     @relation("ReviewByStudent", fields: [studentId], references: [id])
  tutorId   String
  tutor     User     @relation("ReviewOfTutor", fields: [tutorId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model PolicyAcceptance {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  policyType PolicyType
  version    String
  acceptedAt DateTime   @default(now())

  @@unique([userId, policyType, version])
}

model Dispute {
  id              String        @id @default(cuid())
  raisedById      String
  raisedBy        User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  againstId       String
  against         User          @relation("DisputeAgainst", fields: [againstId], references: [id])
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id])
  reason          String
  status          DisputeStatus @default(OPEN)
  resolutionNotes String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// A general "report an issue" channel for students and tutors — unlike
// Dispute (which always names a booking and a counterparty), this covers
// anything from a billing question to a bug report, with a booking as an
// optional bit of context rather than a requirement.
model IssueReport {
  id          String        @id @default(cuid())
  reporterId  String
  reporter    User          @relation(fields: [reporterId], references: [id])
  category    IssueCategory
  subject     String
  description String
  bookingId   String?
  booking     Booking?      @relation(fields: [bookingId], references: [id])
  status      DisputeStatus @default(OPEN)
  adminNotes  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  timestamp  DateTime @default(now())
}
